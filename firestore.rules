rules_version = '2';
// Passinho schema 2: family documents contain the children/tasks/guardians maps,
// bath configuration and audit list. Only that family's member UIDs can read it.
// members/{uid}: immutable UID + admin/child role; only an existing admin or a
// password-authenticated new-family owner can grant administrative membership.
// checks/{childId|date|taskId}: status, reviewed, by and server updatedAt.
// closures/{childId|date}: closed, by and server updatedAt.
// private/settings and pairing management are restricted to family admins.
// The old standalone /banho tree is retired and inaccessible to all clients.
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit default deny. Specific Passinho rules below are the only grants.
    match /{document=**} { allow read, write: if false; }

    function signedIn() { return request.auth != null; }
    function familyPath(fid) { return /databases/$(database)/documents/passinhoFamilies/$(fid); }
    function memberPath(fid, uid) { return /databases/$(database)/documents/passinhoFamilies/$(fid)/members/$(uid); }
    function member(fid) { return signedIn() && exists(memberPath(fid, request.auth.uid)); }
    function admin(fid) {
      return member(fid) && get(memberPath(fid, request.auth.uid)).data.role == 'admin'
        && request.auth.uid in get(familyPath(fid)).data.guardians;
    }
    function bootstrap(fid) {
      return signedIn() && !exists(familyPath(fid))
        && getAfter(familyPath(fid)).data.ownerUid == request.auth.uid
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function todayLocal() { return request.time - duration.value(3, 'h'); }
    function dateIsToday(date) {
      let parts = date.split('-');
      let now = todayLocal();
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(parts[0]) == now.year() && int(parts[1]) == now.month() && int(parts[2]) == now.day();
    }
    function activeVersion(task) {
      let count = task.versions.size();
      let last = task.versions[count - 1];
      let day = int(todayLocal().toMillis() / 86400000);
      return last.fromDay <= day ? last : (count > 1 ? task.versions[count - 2] : {'active': false, 'weekdays': [], 'fromDay': 99999999});
    }
    function scheduled(fid, data) {
      let root = get(familyPath(fid)).data;
      let task = root.tasks[data.taskId];
      let version = activeVersion(task);
      return data.childId in root.children && task.childId == data.childId
        && version.active == true
        && (version.get('repeat', 'weekly') == 'once'
          ? version.get('onDate', '') == data.date
          : (version.get('repeat', 'weekly') == 'weekly' && (todayLocal().dayOfWeek() % 7) in version.weekdays))
        && version.fromDay <= int(todayLocal().toMillis() / 86400000);
    }
    function openDay(fid, data) {
      let path = /databases/$(database)/documents/passinhoFamilies/$(fid)/closures/$(data.childId + '|' + data.date);
      return !exists(path) || get(path).data.closed != true;
    }
    function checkShape(key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['childId','date','taskId','status','reviewed','by','updatedAt'])
        && d.keys().hasAll(['childId','date','taskId','status','reviewed','by','updatedAt'])
        && key == d.childId + '|' + d.date + '|' + d.taskId
        && d.childId is string && d.taskId is string && d.date is string
        && d.status in ['pending','failed','done'] && d.reviewed is bool
        && d.by == request.auth.uid && d.updatedAt == request.time;
    }
    function childCheck(fid) {
      let d = request.resource.data;
      return member(fid) && d.status in ['pending','done'] && d.reviewed == false
        && dateIsToday(d.date) && openDay(fid, d) && scheduled(fid, d);
    }

    // Retired standalone app: neither anonymous users nor family admins may
    // access the legacy document, sibling documents, or nested subcollections.
    match /banho/{document=**} { allow read, write: if false; }

    match /passinhoPairings/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasOnly(['familyId','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (admin(request.resource.data.familyId) || bootstrap(request.resource.data.familyId));
      allow update: if false;
      allow delete: if admin(resource.data.familyId);
    }
    match /passinhoFamilies/{fid} {
      allow get: if member(fid);
      allow list: if false;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schema == 2
        && request.resource.data.children.size() == 0 && request.resource.data.tasks.size() == 0
        && request.resource.data.guardians.keys().hasOnly([request.auth.uid]);
      allow update: if admin(fid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schema == 2
        && request.resource.data.children is map && request.resource.data.tasks is map
        && request.resource.data.guardians is map && request.resource.data.audit is list
        && request.resource.data.audit.size() <= 500
        && request.auth.uid in request.resource.data.guardians;
      allow delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || admin(fid));
        allow list: if admin(fid);
        allow create: if signedIn() && request.resource.data.uid == uid
          && request.resource.data.role in ['admin','child']
          && request.resource.data.createdAt == request.time
          && (admin(fid) || bootstrap(fid)
            || (request.auth.uid == uid && request.resource.data.role == 'child'
              && request.resource.data.keys().hasOnly(['uid','role','pairingCode','createdAt'])
              && get(/databases/$(database)/documents/passinhoPairings/$(request.resource.data.pairingCode)).data.familyId == fid));
        allow update: if false;
        allow delete: if admin(fid) && uid != request.auth.uid;
      }
      match /private/{key} {
        allow read: if admin(fid);
        allow create: if admin(fid) || bootstrap(fid);
        allow update, delete: if admin(fid);
      }
      match /checks/{key} {
        allow read: if member(fid);
        allow create: if signedIn() && checkShape(key) && (admin(fid) || childCheck(fid));
        allow update: if signedIn() && checkShape(key)
          && (admin(fid) || (resource.data.reviewed == false && childCheck(fid)));
        allow delete: if admin(fid);
      }
      match /closures/{key} {
        allow read: if member(fid);
        allow create, update: if admin(fid)
          && request.resource.data.keys().hasOnly(['childId','date','closed','by','updatedAt'])
          && key == request.resource.data.childId + '|' + request.resource.data.date
          && request.resource.data.closed == true && request.resource.data.by == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if admin(fid);
      }
    }
  }
}
