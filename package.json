{
  "name": "passinho-familia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite src --config vite.config.js --host 127.0.0.1",
    "build": "vite build src --config vite.config.js --base ./ --outDir ../dist --emptyOutDir",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-passinho \"node --test tests/rules/*.test.js\"",
    "android:assets": "node scripts/android-assets.mjs"
  },
  "dependencies": { "firebase": "13.1.0" },
  "devDependencies": { "vite": "^7.0.0", "firebase-tools": "15.34.2", "@firebase/rules-unit-testing": "6.0.0" }
}
